{
  "name": "car-dealership-backend",
  "version": "1.0.0",
  "description": "RESTful API for the Car Dealership Inventory System (TDD Kata)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --config jest.config.js --runInBand",
    "test:unit": "jest --config jest.config.js --runInBand tests/unit",
    "test:integration": "jest --config jest.config.js --runInBand tests/integration",
    "test:coverage": "jest --config jest.config.js --runInBand --coverage",
    "lint": "eslint src tests",
    "seed": "node src/scripts/seed.js",
    "populate:inventory": "node src/scripts/populateInventory.js",
    "sync:inventory-images": "node src/scripts/syncVehicleImages.js",
    "assign:unique-images": "node src/scripts/assignUniqueVehicleImages.js"
  },
  "keywords": [
    "express",
    "mongodb",
    "jwt",
    "car-dealership"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
